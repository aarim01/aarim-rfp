# Database
# Set DATABASE_URL in Vercel/Neon deployments. The other values are for local Docker.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SYNCHRONIZE=
DATABASE_LOGGING=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Redis
# Optional in production. Set REDIS_URL to enable Bull workers on a Redis service.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
PORT=
NODE_ENV=
CORS_ORIGIN=

# Temporary presentation mode
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=

# Scraping
SCRAPING_SCHEDULE=
